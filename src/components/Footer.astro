---
import { Image } from 'astro:assets';
import certificacoes from '../assets/rodape/certificacoes.webp';
import financiamento from '../assets/rodape/financiamento.webp';
import { empresa, servicos } from '../data/site';
---

<footer class="mt-24 bg-brand-900 text-brand-50">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <h2 class="mb-3 text-xl text-white">Localização</h2>
      <address class="not-italic">{empresa.morada.map((l) => <>{l}<br /></>)}</address>
      <p class="mt-3"><a class="hover:text-white hover:underline" href={`tel:${empresa.telefone.replaceAll(' ', '')}`}>{empresa.telefone}</a><br /><a class="hover:text-white hover:underline" href={`mailto:${empresa.email}`}>{empresa.email}</a></p>
    </div>
    <div>
      <h2 class="mb-3 text-xl text-white">Serviços</h2>
      <ul class="space-y-1">{servicos.map((s) => <li><a class="hover:text-white hover:underline" href={s.href}>{s.titulo}</a></li>)}</ul>
    </div>
    <div>
      <h2 class="mb-3 text-xl text-white">Links Úteis</h2>
      <ul class="space-y-1">
        <li><a class="hover:text-white hover:underline" href="/about-us/">Sobre nós</a></li>
        <li><a class="hover:text-white hover:underline" href="/politica-de-privacidade/">Política de Privacidade</a></li>
        <li><a class="hover:text-white hover:underline" href="/politica-de-qualidade/">Política de Qualidade</a></li>
      </ul>
      <h2 class="mt-6 mb-3 text-xl text-white">Redes Sociais</h2>
      <div class="flex gap-3">
        <a href={empresa.facebook} class="rounded-full bg-white/10 p-2 hover:bg-white/20" aria-label="Facebook" rel="noopener" target="_blank">
          <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8.2h2.8l.4-3.2h-3.2v-2c0-.9.3-1.6 1.6-1.6h1.7V4.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.3v2.3H7.4v3.2h2.8V22h3.3Z" /></svg>
        </a>
        <a href={empresa.linkedin} class="rounded-full bg-white/10 p-2 hover:bg-white/20" aria-label="LinkedIn" rel="noopener" target="_blank">
          <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.9 8.7H3.6V20h3.3V8.7ZM5.3 3.5a1.9 1.9 0 1 0 0 3.8 1.9 1.9 0 0 0 0-3.8ZM20.4 13.5c0-3-1.6-5-4.4-5-1.4 0-2.4.8-2.8 1.5V8.7H10V20h3.3v-5.6c0-1.5.3-2.9 2.1-2.9 1.8 0 1.8 1.7 1.8 3V20h3.3v-6.5Z" /></svg>
        </a>
      </div>
    </div>
    <div class="rounded-xl bg-white p-3">
      <Image src={certificacoes} alt="Certificação APCER ISO 9001 (certificado nº 2014/CEP.4670), IQNet e Scoring Top 5% Melhores PME Portugal 2025" widths={[320, 640]} sizes="320px" class="w-full" />
    </div>
  </div>
  <div class="bg-white">
    <div class="container-page py-4">
      <a href="/Cartaz-de-publicitacao.pdf" target="_blank" class="block" aria-label="Projeto financiado pelo PRR, República Portuguesa e União Europeia NextGenerationEU – ver cartaz de publicitação (PDF)">
        <Image src={financiamento} alt="" widths={[640, 1280]} sizes="(min-width: 1152px) 1104px, 100vw" class="mx-auto w-full max-w-4xl" />
      </a>
    </div>
  </div>
  <p class="container-page py-4 text-center text-sm text-brand-100">© {new Date().getFullYear()} {empresa.nome}</p>
</footer>
