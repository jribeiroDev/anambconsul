---
import Form from './Form.astro';

interface Props {
  title?: string;
}
const { title = 'Envie-nos pedidos de informação, sugestões ou elogios.' } = Astro.props;
---

<section id="formulario" class="container-page mt-20 scroll-mt-24">
  <div class="rounded-3xl bg-brand-50 p-6 sm:p-12">
    <h2 class="mb-8 max-w-2xl text-3xl">{title}</h2>
    <Form id="contacto" />
  </div>
</section>
