---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  subtitle?: string;
  image?: ImageMetadata;
}
const { title, subtitle, image } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-gradient-to-br from-brand-900 via-brand-800 to-water-700 text-white">
  {image && <Image src={image} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" class="absolute inset-0 -z-10 size-full object-cover opacity-30" />}
  <div class="container-page py-20 sm:py-28">
    <h1 class="max-w-3xl text-4xl text-white sm:text-5xl"><slot name="title">{title}</slot></h1>
    {subtitle && <p class="mt-4 max-w-2xl text-xl text-brand-50">{subtitle}</p>}
  </div>
</section>
