---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ClientLogos from '../components/ClientLogos.astro';
import ContactSection from '../components/ContactSection.astro';
import { servicos } from '../data/site';
import slideAguas from '../assets/slides/aguas.png';
import slideLegionella from '../assets/slides/legionella.png';
import slideQai from '../assets/slides/qai.png';

// slides originais (texto incluído na imagem → repetido no alt)
const slides = [
  { img: slideAguas, href: '/tratamento-de-aguas/', alt: 'Tratamento de Águas – consumo humano e piscinas' },
  { img: slideLegionella, href: '/prevencao-de-legionella/', alt: 'Plano de Prevenção e Controlo de Legionella' },
  { img: slideQai, href: '/qualidade-do-ar-interior/', alt: 'Monitorização da Qualidade do Ar Interior (QAI)' },
];
---

<Base title="Início">
  <section aria-label="Destaques" class="bg-brand-900">
    <div class="flex snap-x snap-mandatory overflow-x-auto [scrollbar-width:none]" data-carousel>
      {
        slides.map((s, i) => (
          <a id={`slide-${i + 1}`} href={s.href} class="w-full shrink-0 snap-start">
            <Image src={s.img} alt={s.alt} widths={[640, 1280, 1920, 2240]} sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} class="aspect-[16/9] max-h-[80vh] w-full object-cover" />
          </a>
        ))
      }
    </div>
    <nav aria-label="Navegação dos destaques" class="flex justify-center gap-3 py-3">
      {slides.map((s, i) => <a href={`#slide-${i + 1}`} class="size-3 rounded-full bg-white/40 hover:bg-white" aria-label={`Destaque ${i + 1}: ${s.alt}`} />)}
    </nav>
  </section>

  <section class="container-page py-20 text-center">
    <h1 class="text-4xl sm:text-5xl">Consultoria em Ar e Águas</h1>
    <div class="mx-auto mt-4 h-1 w-20 rounded bg-brand-500"></div>
    <p class="mx-auto mt-6 max-w-3xl text-xl leading-relaxed">
      Fornecemos serviços de excelência tendo o cliente como foco principal. Temos uma equipa multidisciplinar, com elevado know-how e experiência, que garante as
      melhores soluções técnicas com vista ao rigoroso cumprimento de todos os requisitos legais aplicáveis e respeitando as melhores práticas nacionais e internacionais.
    </p>
  </section>

  <section class="container-page grid gap-6 sm:grid-cols-2 lg:grid-cols-4" aria-label="Serviços">
    {
      servicos.map((s) => (
        <a href={s.href} class="group flex flex-col rounded-2xl border border-brand-100 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
          <span class="grid size-16 place-items-center rounded-2xl bg-gradient-to-br from-brand-500 to-water-500">
            <Image src={s.icon} alt="" width={48} height={48} class="size-10" />
          </span>
          <h2 class="mt-5 text-2xl group-hover:text-brand-700">{s.titulo}</h2>
          <p class="mt-3 flex-1 text-base leading-relaxed">{s.resumo}</p>
          <span class="mt-4 text-brand-700">Saber mais →</span>
        </a>
      ))
    }
  </section>

  <section class="mt-24 bg-brand-50 py-16">
    <div class="container-page text-center">
      <h2 class="text-4xl">Clientes</h2>
      <div class="mx-auto mt-4 h-1 w-20 rounded bg-brand-500"></div>
      <p class="mt-6 text-xl">Estes são alguns dos clientes que confiam no trabalho e profissionalismo da AnambConsul</p>
    </div>
    <div class="mt-10"><ClientLogos /></div>
  </section>

  <ContactSection />
</Base>

<script>
  // avanço automático do carrossel (pausa ao interagir; desativado com reduced-motion)
  const track = document.querySelector<HTMLElement>('[data-carousel]');
  if (track && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let timer = setInterval(() => {
      const next = track.scrollLeft + track.clientWidth >= track.scrollWidth - 5 ? 0 : track.scrollLeft + track.clientWidth;
      track.scrollTo({ left: next, behavior: 'smooth' });
    }, 6000);
    for (const ev of ['pointerdown', 'focusin', 'wheel']) track.addEventListener(ev, () => clearInterval(timer), { once: true });
  }
</script>
