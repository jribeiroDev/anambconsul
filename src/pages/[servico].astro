---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactSection from '../components/ContactSection.astro';

export async function getStaticPaths() {
  const servicos = await getCollection('servicos');
  return servicos.map((entry) => ({ params: { servico: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, description, subtitle, banner, cards, cta } = entry.data;
const { Content } = await render(entry);
---

<Base title={title} description={description}>
  <PageHero title={title} subtitle={subtitle} image={banner} />

  <article class="container-page prose prose-lg mt-16 max-w-3xl prose-headings:font-semibold prose-headings:text-brand-900 prose-a:text-brand-700 prose-img:rounded-2xl prose-img:shadow-md prose-li:marker:text-brand-500">
    <Content />
  </article>

  {
    cards && (
      <section class="container-page mt-16 grid gap-6 sm:grid-cols-3" aria-label="Áreas de intervenção">
        {cards.map((c) => {
          const Tag = c.href ? 'a' : 'div';
          return (
            <Tag href={c.href} class:list={['group overflow-hidden rounded-2xl border border-brand-100 bg-white shadow-sm', c.href && 'transition hover:-translate-y-1 hover:shadow-lg']}>
              <Image src={c.image} alt="" widths={[400, 800]} sizes="(min-width: 640px) 33vw, 100vw" class="aspect-[16/9] w-full object-cover sm:aspect-square" />
              <div class="p-5">
                <h2 class="text-2xl group-hover:text-brand-700">{c.title}</h2>
                {c.text && <p class="mt-2 text-base">{c.text}</p>}
                {c.href && <span class="mt-3 inline-block text-brand-700">Ver mais →</span>}
              </div>
            </Tag>
          );
        })}
      </section>
    )
  }

  {
    cta && (
      <section class="container-page mt-16">
        <div class="flex flex-col items-start gap-4 rounded-3xl bg-gradient-to-r from-brand-800 to-water-700 p-8 text-white sm:flex-row sm:items-center sm:justify-between">
          <p class="max-w-xl text-xl">{cta.text}</p>
          <a href={cta.href} class="shrink-0 rounded-full bg-white px-6 py-3 text-brand-900 hover:bg-brand-50">{cta.label}</a>
        </div>
      </section>
    )
  }

  <ContactSection />
</Base>
