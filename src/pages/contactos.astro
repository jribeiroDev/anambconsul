---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactSection from '../components/ContactSection.astro';
import { empresa } from '../data/site';

const card = 'rounded-2xl border border-brand-100 bg-white p-6';
---

<Base title="Contactos" description="Contacte a AnambConsul: Rua do Comércio nº 541, Vilarinho das Cambas, Vila Nova de Famalicão. Tel. +351 252 378 031, geral@anambconsul.pt.">
  <PageHero
    title="Contacte-nos"
    subtitle="Contacte-nos para esclarecer dúvidas sobre a informação e os serviços disponibilizados pela Anambconsul, ou para apoio na resolução de problemas encontrados."
  />

  <section class="container-page mt-16 grid gap-6 md:grid-cols-3">
    <div class={card}>
      <h2 class="text-2xl">Morada</h2>
      <address class="mt-3 not-italic">{empresa.morada.map((l) => <>{l}<br /></>)}</address>
    </div>
    <div class={card}>
      <h2 class="text-2xl">E-mail</h2>
      <p class="mt-3"><a class="text-brand-700 underline" href={`mailto:${empresa.email}`}>{empresa.email}</a></p>
    </div>
    <div class={card}>
      <h2 class="text-2xl">Telefone</h2>
      <p class="mt-3"><a class="text-brand-700 underline" href={`tel:${empresa.telefone.replaceAll(' ', '')}`}>{empresa.telefone}</a></p>
      <p class="text-base text-ink/70">(Chamada para rede fixa nacional)</p>
    </div>
  </section>

  <section class="container-page mt-10">
    <iframe
      src={empresa.mapa}
      title="Mapa: localização da AnambConsul"
      class="h-96 w-full rounded-2xl border-0"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen></iframe>
  </section>

  <ContactSection title="Fale Connosco" />
</Base>
